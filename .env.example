# Copy to .env (or export in your shell) — all optional.

# auto (default): try live sources, fall back to bundled sample data
# live: live sources only (errors surface)
# sample: bundled synthetic dataset only
DATA_MODE=auto

# Free key from https://comtradedeveloper.un.org — raises rate limits and
# record caps. Without it the public preview endpoint is used (500 records/call).
COMTRADE_API_KEY=

# Optional free key from census.gov — raises the US Census API daily allowance.
CENSUS_API_KEY=

# P2/P3 local-file ingestion (see app/pipelines/national_csv.py for schema)
INDONESIA_BPS_CSV=
MALAYSIA_DOSM_CSV=
CHINA_GACC_CSV=

# Brazil Comex Stat needs no key — it activates automatically whenever
# DATA_MODE is not "sample" (see app/pipelines/brazil_comexstat.py).

# SQLite cache/store location (default: data/trade.sqlite)
TRADE_DB_PATH=

# Server port for `python -m app` (default 8000)
PORT=8000
